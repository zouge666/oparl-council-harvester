# copy this file to .env and change the password
# .env is in .gitignore so it never gets commited

# used by docker compose for the local database
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iris

# used by the harvester
DATABASE_URL=postgresql://iris:change-me@localhost:5432/iris

# used by the database tests. this database gets emptied, dont point it at real data
TEST_DATABASE_URL=postgresql://iris:change-me@localhost:5432/iris_test
